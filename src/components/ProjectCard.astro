---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, summary, client, role, year, tags, cover, coverAlt } = project.data;
---

<article class="card">
  <a href={`/work/${project.id}`} class="link">
    <div class="media">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 700px) 640px, 100vw"
        loading={index < 1 ? 'eager' : 'lazy'}
      />
    </div>
    <div class="body">
      <div class="title-row">
        <h2>{title}</h2>
        <span class="year">{year}</span>
      </div>
      <p class="meta">{client} · {role}</p>
      <p class="summary">{summary}</p>
      <p class="tags">{tags.join(' / ')}</p>
    </div>
  </a>
</article>

<style>
  .link {
    display: block;
  }
  .media {
    overflow: hidden;
    aspect-ratio: 16 / 11;
    border-radius: 14px;
    background: var(--a-card);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 12px 32px -16px rgb(0 0 0 / 0.25);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .link:hover .media {
    transform: translateY(-4px);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 24px 48px -20px rgb(0 0 0 / 0.35);
  }
  .body {
    padding: 20px 4px 0;
  }
  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .year {
    font-family: var(--a-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.09em;
    color: var(--a-muted);
  }
  .meta {
    font-weight: 500;
  }
  .summary {
    margin-top: 4px;
    color: var(--a-muted);
  }
  .tags {
    margin-top: 12px;
    font-family: var(--a-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--a-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .media {
      transition: none;
    }
  }
</style>
