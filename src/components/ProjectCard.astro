---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, summary, client, year, tags, cover, coverAlt } = project.data;
---

<article class="card">
  <a href={`/work/${project.id}`} class="link">
    <div class="media">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[600, 900, 1400]}
        sizes="(min-width: 900px) 50vw, 100vw"
        loading={index < 2 ? 'eager' : 'lazy'}
      />
    </div>
    <div class="body">
      <p class="eyebrow">{client} · {year}</p>
      <h3>{title}</h3>
      <p class="summary">{summary}</p>
      <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>
    </div>
  </a>
</article>

<style>
  .link {
    display: block;
    text-decoration: none;
  }
  .link:hover {
    color: inherit;
  }
  .media {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    aspect-ratio: 4 / 3;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .link:hover .media :global(img) {
    transform: scale(1.03);
  }
  .body {
    padding-top: 1.25rem;
  }
  h3 {
    font-size: var(--step-2);
    margin-top: 0.4rem;
  }
  .link:hover h3 {
    color: var(--accent);
  }
  .summary {
    color: var(--ink-muted);
    margin: 0.5rem 0 0;
    max-width: 48ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    font-size: var(--step--1);
  }
  .tags li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .media :global(img) {
      transition: none;
    }
  }
</style>
