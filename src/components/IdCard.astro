---
import { site } from '../site';
---

<a class="id" href="/" aria-label={`${site.name}, home`}>
  <span class="id-name">{site.name}</span>
  <span>{site.place}</span>
  <span>{site.coordinates}</span>
  <span>{site.timezone}</span>
</a>

<style>
  .id {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 32px;
    font-family: var(--a-mono);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.8;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--a-muted);
  }
  .id-name {
    color: var(--a-ink);
  }
  @media (min-width: 900px) {
    .id {
      position: absolute;
      top: 72px;
      left: 54px;
      align-items: flex-start;
      padding: 12px 0 12px 30px;
      border-left: 4px dotted var(--a-faint);
    }
  }
</style>
