---
interface Props {
  eyebrow: string;
}

const { eyebrow } = Astro.props;
---

<section class="container hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1><slot /></h1>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 10vw, 9rem) clamp(3rem, 8vw, 6rem);
  }
  h1 {
    font-size: var(--step-3);
    max-width: 22ch;
    margin-top: 1.25rem;
  }
</style>
