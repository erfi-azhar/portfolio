---
import { site } from '../site';
const year = new Date().getFullYear();
---

<footer class="container footer" id="contact">
  <p class="eyebrow">Have a project in mind?</p>
  <a class="cta" href={`mailto:${site.email}`}>{site.email}</a>
  <div class="meta">
    <ul>
      {site.links.map((l) => <li><a href={l.href} rel="me noopener" target="_blank">{l.label}</a></li>)}
    </ul>
    <p>© {year} {site.name}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(4rem, 10vw, 8rem);
    padding-block: 3rem 2rem;
    border-top: 1px solid var(--line);
  }
  .cta {
    display: inline-block;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.1;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  p {
    margin: 0;
  }
</style>
