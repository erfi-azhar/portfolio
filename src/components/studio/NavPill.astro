---
import { Image } from 'astro:assets';
import portrait from '../../assets/about/portrait.svg';
import { site } from '../../site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<nav class="pill-nav" aria-label="Main">
  <div class="pill">
    <div class="links">
      <span class="highlight" aria-hidden="true"></span>
      {
        links.map((l) => (
          <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </div>
    <span class="divider" aria-hidden="true"></span>
    <a class="avatar" href="/about" aria-label={`About ${site.name}`}>
      <Image src={portrait} alt="" width={80} />
    </a>
  </div>
</nav>

<script>
  // The highlight sits behind the current page and slides to whichever link
  // the pointer or keyboard focus is on.
  for (const nav of document.querySelectorAll<HTMLElement>('.pill-nav')) {
    const box = nav.querySelector<HTMLElement>('.links')!;
    const hl = nav.querySelector<HTMLElement>('.highlight')!;
    const links = [...box.querySelectorAll<HTMLAnchorElement>('a')];
    const current = links.find((a) => a.getAttribute('aria-current') === 'page');

    const moveTo = (a?: HTMLElement) => {
      if (!a) {
        hl.style.opacity = '0';
        return;
      }
      hl.style.opacity = '1';
      hl.style.width = `${a.offsetWidth}px`;
      hl.style.transform = `translateX(${a.offsetLeft}px)`;
    };

    moveTo(current);
    requestAnimationFrame(() => hl.classList.add('ready'));
    for (const a of links) {
      a.addEventListener('pointerenter', () => moveTo(a));
      a.addEventListener('focus', () => moveTo(a));
    }
    box.addEventListener('pointerleave', () => moveTo(current));
    box.addEventListener('focusout', () => moveTo(current));
    window.addEventListener('resize', () => moveTo(current));
  }
</script>

<style>
  .pill-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: calc(32px + env(safe-area-inset-bottom, 0px));
    z-index: 50;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .pill {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 4px 4px 8px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--surface-raised);
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.6);
    pointer-events: auto;
  }
  .links {
    position: relative;
    display: flex;
    align-items: center;
  }
  .highlight {
    position: absolute;
    left: 0;
    top: 50%;
    height: 40px;
    margin-top: -20px;
    border-radius: 999px;
    background: var(--surface-raised);
    opacity: 0;
  }
  .highlight:global(.ready) {
    transition:
      transform 0.35s var(--ease-out),
      width 0.35s var(--ease-out),
      opacity 0.2s;
  }
  .links a {
    position: relative;
    z-index: 1;
    padding: 8px clamp(16px, 2vw, 24px);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    color: var(--muted);
    transition: color 0.2s;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--fg);
  }
  .links a[aria-current='page'] {
    font-weight: 600;
  }
  .divider {
    width: 1px;
    height: 24px;
    margin-inline: 8px 6px;
    background: var(--border);
  }
  .avatar {
    display: block;
    width: 40px;
    height: 40px;
    overflow: hidden;
    border-radius: 50%;
    border: 2px solid var(--surface-raised);
    transition: transform 0.25s var(--ease-out);
  }
  .avatar:hover {
    transform: scale(1.06);
  }
  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  @media (prefers-reduced-motion: reduce) {
    .highlight:global(.ready) {
      transition: none;
    }
  }
</style>
