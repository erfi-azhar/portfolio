---
import { site } from '../../site';

const year = new Date().getFullYear();
const columns = [
  {
    title: 'Pages',
    links: [
      { label: 'Home', href: '/' },
      { label: 'Work', href: '/work' },
      { label: 'About', href: '/about' },
    ],
  },
  { title: 'Social', links: site.links.map((l) => ({ ...l, external: true })) },
  {
    title: 'Resources',
    links: [
      ...(site.resume ? [{ label: 'View résumé', href: site.resume, external: true }] : []),
      { label: 'Copy email', href: `mailto:${site.email}`, copy: true },
    ],
  },
];
---

<footer class="footer">
  <div class="content top">
    <div>
      <p class="name">{site.name}</p>
      <p class="role">{site.role}</p>
    </div>
    <div class="cols">
      {
        columns.map((c) => (
          <div>
            <p class="col-title">{c.title}</p>
            <ul>
              {c.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    {...('external' in l && l.external ? { target: '_blank', rel: 'me noopener' } : {})}
                    {...('copy' in l && l.copy ? { 'data-copy-email': '' } : {})}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  <div class="content bottom">
    <div class="legal">
      <p>© {year} {site.name}</p>
      <p>Designed in {site.place.split(',')[0]}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    border-top: 1px solid color-mix(in oklch, var(--fg) 10%, transparent);
    background: var(--bg);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
    padding-top: clamp(64px, 6vw, 80px);
  }
  .name {
    font-size: 14px;
    font-weight: 600;
  }
  .role {
    font-size: 12px;
    color: var(--muted);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 0 clamp(32px, 5vw, 64px);
  }
  .col-title {
    margin-bottom: 14px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--muted) 60%, transparent);
  }
  ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li a {
    font-size: 14px;
    color: var(--muted);
    transition: color 0.2s;
  }
  li a:hover {
    color: var(--fg);
  }
  .bottom {
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: calc(112px + env(safe-area-inset-bottom, 0px));
  }
  @media (min-width: 640px) {
    .bottom {
      padding-bottom: 80px;
    }
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    font-size: 12px;
    color: color-mix(in oklch, var(--muted) 50%, transparent);
  }
</style>
