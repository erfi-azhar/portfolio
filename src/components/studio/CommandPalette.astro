---
import { getCollection } from 'astro:content';
import { site } from '../../site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

type Item = { group: string; label: string; hint?: string; href?: string; action?: string; external?: boolean };
const items: Item[] = [
  { group: 'Pages', label: 'Home', href: '/' },
  { group: 'Pages', label: 'Work', href: '/work' },
  { group: 'Pages', label: 'About', href: '/about' },
  ...projects.map((p) => ({ group: 'Case studies', label: p.data.title, hint: p.data.client, href: `/work/${p.id}` })),
  { group: 'Actions', label: 'Copy email', hint: site.email, action: 'copy-email' },
  ...(site.resume ? [{ group: 'Actions', label: 'View résumé', href: site.resume, external: true }] : []),
  ...site.links.map((l) => ({ group: 'Social', label: l.label, href: l.href, external: true })),
];
const groups = [...new Set(items.map((i) => i.group))];
---

<div class="cmdk-trigger-wrap">
  <button class="cmdk-trigger" type="button" aria-haspopup="dialog" aria-controls="cmdk">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
    </svg>
    <span class="visually-hidden">Search</span>
    <kbd class="kbd">⌘K</kbd>
  </button>
</div>

<dialog id="cmdk" class="cmdk" aria-label="Search the site">
  <div class="panel">
    <div class="search">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      <input id="cmdk-input" type="text" placeholder="Search pages, work and links" autocomplete="off" spellcheck="false" aria-controls="cmdk-list" />
      <kbd class="kbd">Esc</kbd>
    </div>
    <div id="cmdk-list" class="list" role="listbox" aria-label="Results">
      {
        groups.map((g) => (
          <div class="group" data-group={g}>
            <p class="group-label">{g}</p>
            {items
              .filter((i) => i.group === g)
              .map((i) => (
                <a
                  class="item"
                  role="option"
                  href={i.href ?? '#'}
                  data-action={i.action}
                  data-search={`${i.label} ${i.hint ?? ''} ${g}`.toLowerCase()}
                  {...(i.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  <span>{i.label}</span>
                  {i.hint && <span class="hint">{i.hint}</span>}
                </a>
              ))}
          </div>
        ))
      }
      <p class="empty" hidden>No matches.</p>
    </div>
  </div>
</dialog>

<p class="toast" role="status" aria-live="polite"></p>

<script>
  import { site } from '../../site';

  const dialog = document.querySelector<HTMLDialogElement>('#cmdk')!;
  const input = dialog.querySelector<HTMLInputElement>('#cmdk-input')!;
  const items = [...dialog.querySelectorAll<HTMLAnchorElement>('.item')];
  const groups = [...dialog.querySelectorAll<HTMLElement>('.group')];
  const empty = dialog.querySelector<HTMLElement>('.empty')!;
  const toast = document.querySelector<HTMLElement>('.toast')!;
  let active = 0;

  const visible = () => items.filter((i) => !i.hidden);
  const setActive = (n: number) => {
    const list = visible();
    if (!list.length) return;
    active = (n + list.length) % list.length;
    list.forEach((el, i) => el.setAttribute('aria-selected', String(i === active)));
    list[active].scrollIntoView({ block: 'nearest' });
  };
  const filter = () => {
    const q = input.value.trim().toLowerCase();
    for (const i of items) i.hidden = !!q && !i.dataset.search!.includes(q);
    for (const g of groups) g.hidden = ![...g.querySelectorAll<HTMLElement>('.item')].some((i) => !i.hidden);
    empty.hidden = visible().length > 0;
    setActive(0);
  };
  const open = () => {
    if (dialog.open) return;
    input.value = '';
    filter();
    dialog.showModal();
    input.focus();
  };
  const close = () => dialog.open && dialog.close();

  let toastTimer = 0;
  const say = (msg: string) => {
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove('show'), 2200);
  };
  const copyEmail = async () => {
    try {
      await navigator.clipboard.writeText(site.email);
      say(`Copied ${site.email}`);
    } catch {
      say(site.email);
    }
  };
  // Footer and other "Copy email" buttons share the same handler.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy-email]');
    if (btn) {
      e.preventDefault();
      copyEmail();
    }
  });

  document.querySelector('.cmdk-trigger')!.addEventListener('click', open);
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? close() : open();
    }
  });
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) close();
  });
  input.addEventListener('input', filter);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') (e.preventDefault(), setActive(active + 1));
    else if (e.key === 'ArrowUp') (e.preventDefault(), setActive(active - 1));
    else if (e.key === 'Enter') {
      e.preventDefault();
      visible()[active]?.click();
    }
  });
  for (const item of items) {
    item.addEventListener('pointermove', () => setActive(visible().indexOf(item)));
    item.addEventListener('click', (e) => {
      if (item.dataset.action === 'copy-email') {
        e.preventDefault();
        copyEmail();
      }
      close();
    });
  }
</script>

<style>
  .cmdk-trigger-wrap {
    position: fixed;
    top: calc(24px + env(safe-area-inset-top, 0px));
    right: 24px;
    z-index: 50;
  }
  .cmdk-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 0;
    border-radius: 999px;
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .cmdk-trigger:hover {
    background: var(--surface-raised);
  }
  .kbd {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  .cmdk-trigger .kbd {
    color: var(--fg);
  }
  @media (max-width: 767px) {
    .cmdk-trigger .kbd {
      display: none;
    }
  }

  .cmdk {
    width: min(560px, calc(100% - 32px));
    max-height: min(520px, 75vh);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--surface-raised);
    border-radius: 16px;
    background: var(--surface);
    color: var(--fg);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.8);
    overflow: hidden;
  }
  .cmdk[open] {
    animation: cmdk-in 0.18s var(--ease-out);
  }
  .cmdk::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(4px);
  }
  @keyframes cmdk-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }
  .panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--surface-raised);
    color: var(--muted);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    font-size: 16px;
    outline: none;
  }
  .search input::placeholder {
    color: var(--muted);
  }
  .list {
    overflow-y: auto;
    padding: 8px;
  }
  .group + .group {
    margin-top: 8px;
  }
  .group-label {
    padding: 6px 10px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .item {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px;
    border-radius: 10px;
    font-size: 14px;
  }
  .item[aria-selected='true'] {
    background: var(--surface-raised);
  }
  .hint {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted);
  }
  .empty {
    padding: 16px 10px;
    color: var(--muted);
    font-size: 14px;
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: calc(104px + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--surface-raised);
    color: var(--fg);
    font-size: 13px;
    opacity: 0;
    transform: translate(-50%, 6px);
    transition:
      opacity 0.2s,
      transform 0.2s var(--ease-out);
    pointer-events: none;
  }
  .toast:global(.show) {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>
