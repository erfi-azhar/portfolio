---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../site';

// Replace with your own story and history.
const statement =
  "Hi, I'm Erfi. I've spent the last eight years turning complicated financial products into things people actually understand.";

const bio = [
  'Write two or three short paragraphs here. Lead with what you care about and the kinds of problems you like solving, not a list of tools.',
  "Then give a little context: where you've worked, what you're known for on a team, and what you're looking for next.",
];

const experience = [
  { company: 'Company Name', role: 'Senior Product Designer', years: '2023 — Now' },
  { company: 'Company Name', role: 'Product Designer', years: '2020 — 2023' },
  { company: 'Studio Name', role: 'UI/UX Designer', years: '2018 — 2020' },
];

const capabilities = [
  'Product strategy',
  'User research',
  'Interaction design',
  'Design systems',
  'Prototyping',
  'Workshop facilitation',
];
---

<Base title="About" description={`About ${site.name}, ${site.role}.`}>
  <Hero eyebrow={`About — ${site.location}`}>{statement}</Hero>

  <section class="container" aria-labelledby="story-heading">
    <SectionHead id="story-heading" title="Story" />
    <div class="bio">
      {bio.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="container block" aria-labelledby="experience-heading">
    <SectionHead
      id="experience-heading"
      title="Experience"
      meta={`${experience.length} roles`}
    />
    <ul class="list">
      {
        experience.map((e) => (
          <li>
            <span class="role">{e.role}</span>
            <span class="company">{e.company}</span>
            <span class="years">{e.years}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container block" aria-labelledby="capabilities-heading">
    <SectionHead id="capabilities-heading" title="Capabilities" />
    <ul class="caps">{capabilities.map((c) => <li>{c}</li>)}</ul>
  </section>
</Base>

<style>
  .block {
    margin-top: clamp(4rem, 8vw, 6rem);
  }
  .bio {
    display: grid;
    gap: 1.25rem var(--gutter);
  }
  @media (min-width: 900px) {
    .bio {
      grid-template-columns: 1fr 1fr;
    }
  }
  .bio p {
    font-size: var(--step-1);
    line-height: 1.5;
    margin: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .list li:first-child {
    padding-top: 0;
  }
  .role {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .company {
    color: var(--ink-muted);
    grid-row: 2;
  }
  .years {
    color: var(--ink-muted);
    font-size: var(--step--1);
    white-space: nowrap;
    text-align: right;
  }
  @media (min-width: 900px) {
    .list li {
      grid-template-columns: 1fr 1fr 8rem;
      align-items: baseline;
    }
    .company {
      grid-row: auto;
    }
  }
  .caps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .caps li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
  }
</style>
