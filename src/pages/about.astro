---
import { Image } from 'astro:assets';
import StudioLayout from '../layouts/StudioLayout.astro';
import { site } from '../site';
import { timeline, education, milestones, toMonth, thisMonth, shortDate } from '../data/career';
import portrait from '../assets/about/portrait.svg';
import memory1 from '../assets/about/memory-1.svg';
import memory2 from '../assets/about/memory-2.svg';
import memory3 from '../assets/about/memory-3.svg';
import memory4 from '../assets/about/memory-4.svg';
import memory5 from '../assets/about/memory-5.svg';

// ——— Edit everything in this block ———

const intro =
  'More than a decade designing products with startups and enterprises in Silicon Valley, New York, Shanghai, Hong Kong and Singapore.';

const closing = {
  title: 'Thanks for stopping by.',
  body: 'A few snapshots from outside the screen.',
};

const memories = [
  { src: memory1, alt: 'Caption one' },
  { src: memory2, alt: 'Caption two' },
  { src: memory3, alt: 'Caption three' },
  { src: memory4, alt: 'Caption four' },
  { src: memory5, alt: 'Caption five' },
];

// ——— End of editable block ———

// ——— Career journey layout ———
// Years run left to right. Each role is a card as wide as its time there;
// overlapping roles drop into separate lanes, and so do overlapping studies.
const now = thisMonth();
type Item = {
  start: string;
  end?: string;
  title: string;
  org: string;
  logo: string;
  current?: boolean;
  lane: number;
};

const pack = (items: Item[]) => {
  const laneEnds: number[] = [];
  for (const item of [...items].sort((a, b) => toMonth(a.start) - toMonth(b.start))) {
    const start = toMonth(item.start);
    let lane = laneEnds.findIndex((end) => end < start);
    if (lane === -1) lane = laneEnds.push(0) - 1;
    laneEnds[lane] = toMonth(item.end ?? now);
    item.lane = lane;
  }
  return Math.max(1, laneEnds.length);
};

const roles: Item[] = timeline.map((r) => ({
  start: r.start,
  end: r.end,
  title: r.role,
  org: r.company,
  logo: r.logos[0],
  current: r.current,
  lane: 0,
}));
const studies: Item[] = education.map((e) => ({
  start: e.start,
  end: e.end,
  title: e.course,
  org: e.school,
  logo: e.logos[0],
  lane: 0,
}));
const roleLanes = pack(roles);
const schoolLanes = pack(studies);

const all = [...roles, ...studies];
const firstYear = Math.min(...all.map((i) => Number(i.start.slice(0, 4))));
const lastYear = Number(now.slice(0, 4)) + 1;
const origin = firstYear * 12;
const years = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => firstYear + i);
const at = (ym: string) => toMonth(ym) - origin;
const span = (i: Item) => toMonth(i.end ?? now) - toMonth(i.start) + 1;
const dates = (i: Item) => `${shortDate(i.start)} — ${i.end ? shortDate(i.end) : 'Now'}`;
---

<StudioLayout title="About" description={`About ${site.name}, ${site.role}.`}>
  <header class="content hero">
    <div class="hero-text">
      <p class="meta reveal">{site.role} · {site.place} · {site.timezone}</p>
      <h1 class="reveal intro">About</h1>
      <p class="lede reveal intro">{intro}</p>
    </div>
    <div class="portrait reveal">
      <Image src={portrait} alt={`Portrait of ${site.name}`} width={480} loading="eager" />
    </div>
  </header>

  <section class="content journey reveal" aria-labelledby="journey-title">
    <div class="journey-head">
      <div>
        <h2 id="journey-title" class="label">Career journey</h2>
        <p class="hint">Scroll sideways through the years.</p>
      </div>
      <div class="journey-nav">
        <button type="button" class="nav-btn" data-dir="-1" aria-label="Earlier years">←</button>
        <button type="button" class="nav-btn" data-dir="1" aria-label="Later years">→</button>
      </div>
    </div>

    <div class="journey-scroll" tabindex="0" role="region" aria-label="Career timeline. Scroll sideways to move through the years." data-lenis-prevent>
      <div
        class="track"
        style={`--months:${(lastYear - firstYear) * 12 + 2};--role-lanes:${roleLanes};--school-lanes:${schoolLanes}`}
      >
        {
          years.map((y, i) => (
            <div class="year" style={`--i:${i}`} aria-hidden="true">
              <span>{y}</span>
            </div>
          ))
        }
        <div class="now" style={`--m:${at(now)}`} aria-hidden="true"><span>Now</span></div>

        {
          roles.map((r) => (
            <div class="card" style={`--m:${at(r.start)};--w:${span(r)};--lane:${r.lane}`}>
              <span class="card-top">
                <span class="chip" aria-hidden="true">
                  {r.logo}
                </span>
                {r.current && <span class="badge">Current</span>}
              </span>
              <span class="card-body">
                <span class="card-title">{r.title}</span>
                <span class="card-org">{r.org}</span>
                <span class="card-dates">{dates(r)}</span>
              </span>
            </div>
          ))
        }

        {
          studies.map((e) => (
            <div class="study" style={`--m:${at(e.start)};--w:${span(e)};--lane:${e.lane}`}>
              <span class="study-name">{e.org}</span>
              <span class="study-course">{e.title}</span>
              <span class="visually-hidden">, {dates(e)}</span>
            </div>
          ))
        }

        {
          milestones.map((m) => (
            <div class="milestone" style={`--m:${at(m.date)}`}>
              <span class="milestone-dot" aria-hidden="true" />
              <span>{m.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="content closing-wrap reveal">
    <div class="closing">
      <div>
        <p class="closing-title">{closing.title}</p>
        <p class="closing-body">{closing.body}</p>
      </div>
      <ul class="memories">
        {
          memories.map((m) => (
            <li>
              <Image src={m.src} alt={m.alt} width={120} title={m.alt} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</StudioLayout>

<script>
  // Career journey: opens at the present and scrolls with arrows, trackpad,
  // keyboard or by dragging with the mouse.
  const scroller = document.querySelector<HTMLElement>('.journey-scroll');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (scroller) {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.nav-btn')];

    const updateEdges = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      const atStart = scroller.scrollLeft <= 2;
      const atEnd = scroller.scrollLeft >= max - 2;
      scroller.classList.toggle('at-start', atStart);
      scroller.classList.toggle('at-end', atEnd);
      buttons[0].disabled = atStart;
      buttons[1].disabled = atEnd;
    };

    // Start at the present so the current role is the first thing you see.
    scroller.scrollLeft = scroller.scrollWidth;
    updateEdges();
    scroller.addEventListener('scroll', updateEdges, { passive: true });
    window.addEventListener('resize', updateEdges);

    for (const b of buttons) {
      b.addEventListener('click', () => {
        scroller.scrollBy({ left: Number(b.dataset.dir) * scroller.clientWidth * 0.6, behavior: reduceMotion ? 'auto' : 'smooth' });
      });
    }

    // Drag to scroll with a mouse.
    let dragFrom: { x: number; left: number } | null = null;
    let dragged = false;
    scroller.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragFrom = { x: e.clientX, left: scroller.scrollLeft };
      dragged = false;
    });
    window.addEventListener('pointermove', (e) => {
      if (!dragFrom) return;
      const dx = e.clientX - dragFrom.x;
      if (!dragged && Math.abs(dx) > 5) {
        dragged = true;
        scroller.classList.add('dragging');
      }
      if (dragged) scroller.scrollLeft = dragFrom.left - dx;
    });
    window.addEventListener('pointerup', () => {
      dragFrom = null;
      scroller.classList.remove('dragging');
    });
  }
</script>

<style>
  /* ——— Hero ——— */
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    padding-top: clamp(120px, 14vw, 200px);
  }
  .hero-text {
    flex: 1 1 420px;
    min-width: 0;
  }
  .meta {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero h1 {
    margin-top: 20px;
    font-size: clamp(44px, 8vw, 112px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--fg);
  }
  .lede {
    max-width: 30ch;
    margin-top: 24px;
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.45;
    color: var(--muted);
    text-wrap: pretty;
  }
  .portrait {
    flex: none;
    width: clamp(140px, 18vw, 220px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 24px;
    background: var(--surface);
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.8);
  }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ——— Career journey ——— */
  .journey {
    --yw: 180px; /* width of one year */
    --axis: 36px;
    --card-h: 132px;
    --bar-h: 40px;
    --gap: 10px;
    --line: color-mix(in oklch, var(--fg) 9%, transparent);
    margin-top: clamp(72px, 9vw, 120px);
  }
  @media (max-width: 640px) {
    .journey {
      --yw: 140px;
      --card-h: 124px;
    }
  }
  .journey-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }
  .label {
    margin: 0;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hint {
    margin-top: 6px;
    font-size: 14px;
    color: var(--muted);
  }
  .journey-nav {
    display: flex;
    gap: 8px;
  }
  .nav-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--surface-raised);
    border-radius: 50%;
    background: var(--surface);
    color: var(--fg);
    font: inherit;
    font-size: 16px;
    cursor: pointer;
    transition:
      background-color 0.2s,
      opacity 0.2s;
  }
  .nav-btn:hover:not(:disabled) {
    background: var(--surface-raised);
  }
  .nav-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Full-bleed strip, lined up with the content column at either end. */
  .journey-scroll {
    --edge: max(var(--gutter), calc((100vw - var(--content)) / 2));
    --fade-l: 48px;
    --fade-r: 48px;
    margin-inline: calc(50% - 50vw);
    padding-inline: var(--edge);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 var(--fade-l), #000 calc(100% - var(--fade-r)), transparent);
    mask-image: linear-gradient(to right, transparent, #000 var(--fade-l), #000 calc(100% - var(--fade-r)), transparent);
  }
  .journey-scroll::-webkit-scrollbar {
    display: none;
  }
  .journey-scroll:global(.at-start) {
    --fade-l: 0px;
  }
  .journey-scroll:global(.at-end) {
    --fade-r: 0px;
  }
  .journey-scroll:global(.dragging) {
    cursor: grabbing;
    user-select: none;
  }
  .journey-scroll:focus-visible {
    outline-offset: -2px;
  }

  .track {
    --schools-top: calc(var(--axis) + var(--role-lanes) * (var(--card-h) + var(--gap)) + 14px);
    --milestones-top: calc(var(--schools-top) + var(--school-lanes) * (var(--bar-h) + 8px) + 10px);
    position: relative;
    width: calc(var(--months) * var(--yw) / 12);
    height: calc(var(--milestones-top) + 32px);
  }

  .year {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--i) * var(--yw));
    border-left: 1px solid var(--line);
  }
  .year span {
    position: absolute;
    top: 4px;
    left: 8px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  .now {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc((var(--m) + 0.5) * var(--yw) / 12);
    border-left: 1px dashed color-mix(in oklch, var(--accent) 70%, transparent);
  }
  .now span {
    position: absolute;
    top: 4px;
    left: 6px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* Role cards */
  .card {
    position: absolute;
    top: calc(var(--axis) + var(--lane) * (var(--card-h) + var(--gap)));
    left: calc(var(--m) * var(--yw) / 12 + 2px);
    width: calc(var(--w) * var(--yw) / 12 - 6px);
    height: var(--card-h);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12px 14px;
    border: 1px solid var(--surface-raised);
    border-radius: 14px;
    background: var(--surface);
    color: var(--fg);
    overflow: hidden;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      transform 0.25s var(--ease-out);
  }
  .card:hover {
    background: var(--surface-raised);
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .chip {
    display: grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--fg);
    color: var(--bg);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 500;
  }
  .badge {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card-body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .card-title,
  .card-org,
  .card-dates {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .card-title {
    font-size: 14px;
    font-weight: 500;
  }
  .card-org {
    font-size: 13px;
    color: var(--muted);
  }
  .card-dates {
    margin-top: 4px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Studies: striped bars below the roles */
  .study {
    position: absolute;
    top: calc(var(--schools-top) + var(--lane) * (var(--bar-h) + 8px));
    left: calc(var(--m) * var(--yw) / 12 + 2px);
    width: calc(var(--w) * var(--yw) / 12 - 6px);
    height: var(--bar-h);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border: 1px solid color-mix(in oklch, var(--accent) 35%, transparent);
    border-radius: 8px;
    background:
      repeating-linear-gradient(315deg, color-mix(in oklch, var(--accent) 22%, transparent) 0 1px, transparent 0 50%) 0 0 / 10px 10px,
      color-mix(in oklch, var(--accent) 12%, transparent);
    color: var(--fg);
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .study:hover {
    border-color: var(--accent);
  }
  .study-name {
    font-weight: 500;
  }
  .study-course {
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--muted);
  }

  .milestone {
    position: absolute;
    top: var(--milestones-top);
    left: calc(var(--m) * var(--yw) / 12);
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .milestone-dot {
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* ——— Closing ——— */
  .closing-wrap {
    padding-block: clamp(72px, 9vw, 120px) clamp(96px, 10vw, 160px);
  }
  .closing {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .closing-title {
    font-weight: 500;
    color: var(--fg);
  }
  .closing-body {
    font-size: 14px;
    color: var(--muted);
  }
  .memories {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0 0 0 10px;
  }
  .memories li {
    margin-left: -12px;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .memories li:nth-child(odd) {
    transform: rotate(-6deg);
  }
  .memories li:nth-child(even) {
    transform: rotate(5deg);
  }
  .memories li:hover {
    transform: translateY(-8px) rotate(0) scale(1.15);
    z-index: 1;
  }
  .memories :global(img) {
    width: 44px;
    height: 57px;
    object-fit: cover;
    border-radius: 4px;
    border: 2px solid var(--surface);
    box-shadow: 0 4px 10px rgb(0 0 0 / 0.2);
  }

  /* On load, sections fade in from a slight blur, one after another. */
  .reveal {
    animation: item-reveal 0.4s var(--ease-out) both;
    animation-delay: var(--reveal-delay, 0ms);
  }
  .intro {
    --reveal-delay: 60ms;
  }
  .journey {
    --reveal-delay: 160ms;
  }
  .closing-wrap {
    --reveal-delay: 240ms;
  }
  @keyframes item-reveal {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(-12px) scale(0.985);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }
  @keyframes item-reveal-reduced {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: item-reveal-reduced 0.2s var(--ease-out) both;
    }
    .card,
    .memories li {
      transition: none;
    }
  }
</style>
