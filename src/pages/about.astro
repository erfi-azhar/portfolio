---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import CvLayout from '../layouts/CvLayout.astro';
import { site } from '../site';
import { timeline, education } from '../data/career';
import portrait from '../assets/about/portrait.svg';
import memory1 from '../assets/about/memory-1.svg';
import memory2 from '../assets/about/memory-2.svg';
import memory3 from '../assets/about/memory-3.svg';
import memory4 from '../assets/about/memory-4.svg';
import memory5 from '../assets/about/memory-5.svg';

// ——— Edit everything in this block ———

const headline = site.role;
const intro =
  'More than a decade designing products with startups and enterprises in Silicon Valley, New York, Shanghai, Hong Kong and Singapore.';

const closing = {
  title: 'Thanks for stopping by.',
  body: 'A few snapshots from outside the screen.',
};

const memories = [
  { src: memory1, alt: 'Caption one' },
  { src: memory2, alt: 'Caption two' },
  { src: memory3, alt: 'Caption three' },
  { src: memory4, alt: 'Caption four' },
  { src: memory5, alt: 'Caption five' },
];

// ——— End of editable block ———

const projectsById = new Map(
  (await getCollection('projects', ({ data }) => !data.draft)).map((p) => [p.id, p]),
);
---

<CvLayout title="About" description={`About ${site.name}, ${site.role}.`}>
  <header class="hero">
    <div class="portrait reveal">
      <Image src={portrait} alt={`Portrait of ${site.name}`} width={240} loading="eager" />
    </div>
    <h1 class="reveal intro">{headline}</h1>
    <p class="reveal intro">{intro}</p>
  </header>

  <div class="track">
    <div class="rail" aria-hidden="true"><div class="rail-lit"></div></div>
    <ol class="timeline" aria-label="Career and education">
      {
        timeline.map((entry) => (
          <li class="entry">
            <span class="when" aria-hidden="true">
              <span class="code">{entry.code}</span>
              <span class="year">{entry.year}</span>
            </span>
            <span class="dot dot-role" aria-hidden="true" />
            <div class="logos" aria-hidden="true">
              {entry.logos.map((l) => (
                <span class="logo">{l}</span>
              ))}
            </div>
            <h2>
              {entry.href ? <a href={entry.href}>{entry.company}</a> : entry.company}
              {entry.current && <span class="badge">Current</span>}
              <span class="visually-hidden">, {entry.year}</span>
            </h2>
            <p class="role">{entry.role}</p>
            {entry.description && <p class="desc">{entry.description}</p>}
  
            {entry.projects && entry.projects.length > 0 && (
              <ul class="projects">
                {entry.projects.map((pid) => {
                  const p = projectsById.get(pid);
                  if (!p) return null;
                  return (
                    <li>
                      <span class="dot dot-case" aria-hidden="true" />
                      <a href={`/work/${p.id}`} class="project">
                        <span class="stack" aria-hidden="true">
                          <span class="card back" />
                          <span class="card mid" />
                          <Image class="card front" src={p.data.cover} alt="" width={96} />
                        </span>
                        <span class="project-text">
                          <span class="project-title">{p.data.title}</span>
                          <span class="project-summary">{p.data.summary}</span>
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            )}
          </li>
        ))
      }
      <li class="entry group">
        <h2 class="label">Education</h2>
      </li>
      {
        education.map((entry) => (
          <li class="entry">
            <span class="when" aria-hidden="true">
              <span class="code">{entry.code}</span>
              <span class="year">{entry.year}</span>
            </span>
            <span class="dot dot-role" aria-hidden="true" />
            <div class="logos" aria-hidden="true">
              {entry.logos.map((l) => (
                <span class="logo">{l}</span>
              ))}
            </div>
            <h3>{entry.school}</h3>
            <p class="role">{entry.course}</p>
            {entry.detail && <p class="desc detail">{entry.detail}</p>}
          </li>
        ))
      }
      <li class="entry end">
        <div class="closing">
          <div>
            <p class="closing-title">{closing.title}</p>
            <p class="closing-body">{closing.body}</p>
          </div>
          <ul class="memories">
            {
              memories.map((m) => (
                <li>
                  <Image src={m.src} alt={m.alt} width={120} title={m.alt} />
                </li>
              ))
            }
          </ul>
        </div>
      </li>
    </ol>
  </div>
</CvLayout>

<script>
  // Draws the timeline's blue line as the page scrolls and lights each dot
  // as the line's tip passes it. The line eases toward the scroll position
  // instead of tracking it exactly, so it glides and settles.
  const track = document.querySelector<HTMLElement>('.track');
  const rail = track?.querySelector<HTMLElement>('.rail');

  if (track && rail) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let dots: { el: HTMLElement; y: number; lit: boolean }[] = [];
    let railTop = 0;
    let railHeight = 0;
    let current = 0;
    let target = 0;
    let frame = 0;

    const measure = () => {
      const box = rail.getBoundingClientRect();
      railTop = box.top + window.scrollY;
      railHeight = box.height;
      dots = [...track.querySelectorAll<HTMLElement>('.dot')].map((el) => {
        const r = el.getBoundingClientRect();
        return { el, y: r.top + r.height / 2 + window.scrollY, lit: el.classList.contains('is-lit') };
      });
    };

    const scrollProgress = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      return max <= 0 ? 1 : Math.min(1, Math.max(0, window.scrollY / max));
    };

    const tick = () => {
      frame = 0;
      const ease = reduceMotion.matches ? 1 : 0.12;
      const gap = target - current;
      current = Math.abs(gap) < 0.0002 ? target : current + gap * ease;
      track.style.setProperty('--rail-p', current.toFixed(4));

      const tip = railTop + railHeight * current;
      for (const dot of dots) {
        const lit = dot.y <= tip;
        if (lit !== dot.lit) {
          dot.lit = lit;
          dot.el.classList.toggle('is-lit', lit);
        }
      }
      if (current !== target) frame = requestAnimationFrame(tick);
    };

    const update = () => {
      target = scrollProgress();
      if (!frame) frame = requestAnimationFrame(tick);
    };

    measure();
    current = scrollProgress();
    update();
    window.addEventListener('scroll', update, { passive: true });
    // Entries slide in on load, so measure again once each one settles.
    track.addEventListener('animationend', (e) => {
      if (e.animationName.includes('item-reveal')) {
        measure();
        update();
      }
    });
    new ResizeObserver(() => {
      measure();
      update();
    }).observe(document.body);
  }
</script>

<style>
  /* ——— Hero ——— */
  .hero {
    max-width: 460px;
    margin: 0 auto;
    padding-top: 40px;
    text-align: center;
  }
  @media (min-width: 900px) {
    .hero {
      padding-top: 96px;
    }
  }
  .portrait {
    width: 180px;
    aspect-ratio: 180 / 234;
    margin: 0 auto 40px;
    padding: 10px;
    border-radius: 90px;
    background: linear-gradient(160deg, #f3efec, #ddd6d2);
    box-shadow:
      0 18px 40px -18px rgb(0 0 0 / 0.35),
      inset 0 1px 0 rgb(255 255 255 / 0.8);
  }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 80px;
    box-shadow: inset 0 4px 12px rgb(0 0 0 / 0.2);
  }
  .hero p {
    color: var(--a-muted);
  }

  /* ——— Timeline ——— */
  .track {
    /* Distance from the content column to the rail. */
    --rail: 22px;
    --pad: calc(var(--rail) + 8px);
    /* Rail position relative to an entry's left edge. */
    --rail-x: calc(-1 * var(--pad));
    position: relative;
    max-width: 560px;
    margin: 56px auto 0;
    padding-left: var(--pad);
  }
  @media (min-width: 900px) {
    .track {
      --pad: 0px;
      --rail-x: calc(-1 * var(--rail));
    }
  }
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Dotted route, with the blue line drawn over it as you scroll. */
  .rail {
    position: absolute;
    top: 8px;
    bottom: 12px;
    left: calc(var(--pad) + var(--rail-x));
    width: 1px;
    background: linear-gradient(to bottom, var(--a-faint) 0 2px, transparent 2px 5.5px) 0 0 / 1px
      5.5px;
  }
  .rail-lit {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--rail-p, 0) * 100%);
    background: var(--a-accent);
    box-shadow:
      0 0 4px color-mix(in srgb, var(--a-accent) 20%, transparent),
      0 0 10px color-mix(in srgb, var(--a-accent) 20%, transparent),
      0 0 20px color-mix(in srgb, var(--a-accent) 14%, transparent);
    opacity: min(1, calc(var(--rail-p, 0) * 60));
  }
  /* Glowing tip; fades out as the line reaches the end. */
  .rail-lit::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 5px;
    height: 5px;
    margin: 0 0 -2.5px -2.5px;
    border-radius: 50%;
    background: var(--a-accent);
    box-shadow:
      0 0 5px 1px color-mix(in srgb, var(--a-accent) 20%, transparent),
      0 0 12px 3px color-mix(in srgb, var(--a-accent) 20%, transparent);
    opacity: min(1, calc((1 - var(--rail-p, 0)) * 25));
  }

  .entry {
    position: relative;
    padding-bottom: 56px;
  }

  /* On load, sections fade in from a slight blur, one after another. */
  .reveal,
  .entry {
    animation: item-reveal 0.4s var(--ease-out) both;
    animation-delay: var(--reveal-delay, 0ms);
  }
  .intro {
    --reveal-delay: 60ms;
  }
  .entry:nth-child(1) {
    --reveal-delay: 120ms;
  }
  .entry:nth-child(2) {
    --reveal-delay: 180ms;
  }
  .entry:nth-child(3) {
    --reveal-delay: 240ms;
  }
  .entry:nth-child(4) {
    --reveal-delay: 300ms;
  }
  .entry:nth-child(5) {
    --reveal-delay: 360ms;
  }
  .entry:nth-child(n + 6) {
    --reveal-delay: 420ms;
  }
  @keyframes item-reveal {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(-12px) scale(0.985);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }
  @keyframes item-reveal-reduced {
    from {
      opacity: 0;
    }
  }

  /* Dots sit on the rail and light up when the line passes them. */
  .dot {
    position: absolute;
    left: var(--rail-x);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    z-index: 1;
    transition:
      border-color 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }
  .dot-role {
    top: 47px;
    width: 11px;
    height: 11px;
    border: 1px solid var(--a-faint);
    background: var(--a-bg);
  }
  .dot-role::after {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background: var(--a-faint);
    transition: background-color 0.3s var(--ease-out);
  }
  .dot-case {
    top: 50%;
    width: 5px;
    height: 5px;
    background: var(--a-faint);
    --pulse-to: 3.6;
  }
  .dot.is-lit {
    border-color: var(--a-accent);
  }
  .dot-role.is-lit::after,
  .dot-case.is-lit {
    background: var(--a-accent);
  }
  .dot::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 1px solid var(--a-accent);
    opacity: 0;
    pointer-events: none;
  }
  .dot.is-lit::before {
    animation: dot-pulse 0.72s var(--ease-out);
  }
  @keyframes dot-pulse {
    from {
      opacity: 0.45;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(var(--pulse-to, 2.4));
    }
  }

  .when {
    display: none;
  }
  @media (min-width: 900px) {
    .when {
      display: block;
      position: absolute;
      top: 47px;
      left: var(--rail-x);
    }
    .code,
    .year {
      position: absolute;
      right: 16px;
      font-family: var(--a-mono);
      font-weight: 500;
      line-height: 1;
      text-align: right;
      white-space: nowrap;
    }
    .code {
      top: -14px;
      font-size: 7px;
      letter-spacing: 0.15em;
      color: var(--a-faint);
    }
    .year {
      top: -5px;
      font-size: 12px;
      letter-spacing: 0.09em;
      color: var(--a-muted);
    }
  }

  .logos {
    display: flex;
    margin-bottom: 4px;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 29px;
    height: 29px;
    margin-right: -7px;
    border-radius: 50%;
    border: 2px solid var(--a-bg);
    background: var(--a-ink);
    color: var(--a-bg);
    font-family: var(--a-mono);
    font-size: 9px;
    font-weight: 500;
  }
  .logo:nth-child(2) {
    background: var(--a-accent);
  }

  .entry h2 {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .entry h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--a-faint);
  }
  /* Section label within the timeline, e.g. "Education". */
  .group {
    padding-bottom: 32px;
  }
  .group .label {
    line-height: 1.8;
    color: var(--a-muted);
  }
  .detail {
    font-family: var(--a-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--a-muted);
  }

  .badge {
    font-family: var(--a-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--a-accent);
  }
  .role {
    font-weight: 500;
  }

  /* Project rows */
  .projects {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
  }
  .projects li {
    position: relative;
  }
  .project {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 12px 10px 20px;
    margin-left: -12px;
    border-radius: 12px;
    transition: background-color 0.2s;
  }
  .project:hover {
    background: color-mix(in srgb, var(--a-ink) 4%, transparent);
  }
  .stack {
    position: relative;
    flex: none;
    width: 56px;
    height: 46px;
  }
  .card {
    position: absolute;
    top: 4px;
    left: 14px;
    width: 30px;
    height: 38px;
    border-radius: 4px;
    background: var(--a-card);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.15);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .back {
    transform: translateX(-10px) rotate(-8deg);
    background: color-mix(in srgb, var(--a-card) 80%, var(--a-faint));
  }
  .mid {
    transform: translateX(10px) rotate(8deg);
    background: color-mix(in srgb, var(--a-card) 90%, var(--a-faint));
  }
  .front {
    top: 0;
    left: 12px;
    width: 34px;
    height: 44px;
    object-fit: cover;
    border: 2px solid var(--a-card);
  }
  .project:hover .back {
    transform: translateX(-16px) rotate(-14deg);
  }
  .project:hover .mid {
    transform: translateX(16px) rotate(14deg);
  }
  .project:hover .front {
    transform: translateY(-2px) scale(1.06);
  }
  .project-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .project-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--a-ink);
  }
  .project-summary {
    font-size: 13px;
    font-weight: 500;
    color: var(--a-muted);
  }

  /* ——— Closing ——— */
  .end {
    padding-bottom: 0;
  }
  .end::before {
    content: '';
    position: absolute;
    top: 10px;
    left: calc(var(--rail-x) - 3.5px);
    width: 7px;
    height: 7px;
    border-right: 1px solid var(--a-accent);
    border-bottom: 1px solid var(--a-accent);
    transform: rotate(45deg);
    background: var(--a-bg);
  }
  .closing {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .closing-title {
    font-weight: 500;
    color: var(--a-ink);
  }
  .closing-body {
    font-size: 14px;
  }
  .memories {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0 0 0 10px;
  }
  .memories li {
    margin-left: -12px;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .memories li:nth-child(odd) {
    transform: rotate(-6deg);
  }
  .memories li:nth-child(even) {
    transform: rotate(5deg);
  }
  .memories li:hover {
    transform: translateY(-8px) rotate(0) scale(1.15);
    z-index: 1;
  }
  .memories :global(img) {
    width: 44px;
    height: 57px;
    object-fit: cover;
    border-radius: 4px;
    border: 2px solid var(--a-card);
    box-shadow: 0 4px 10px rgb(0 0 0 / 0.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal,
    .entry {
      animation: item-reveal-reduced 0.2s var(--ease-out) both;
    }
    .dot.is-lit::before {
      animation: none;
    }
    .card,
    .memories li,
    .project {
      transition: none;
    }
  }
</style>
