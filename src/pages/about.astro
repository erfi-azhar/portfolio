---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import CvLayout from '../layouts/CvLayout.astro';
import { site } from '../site';
import portrait from '../assets/about/portrait.svg';
import memory1 from '../assets/about/memory-1.svg';
import memory2 from '../assets/about/memory-2.svg';
import memory3 from '../assets/about/memory-3.svg';
import memory4 from '../assets/about/memory-4.svg';
import memory5 from '../assets/about/memory-5.svg';

// ——— Edit everything in this block ———

const headline = site.role;
const intro =
  'Eight years of turning complicated financial products into things people actually understand.';

// Newest first. `projects` are ids of files in src/content/projects.
const timeline = [
  {
    code: 'JKT',
    year: 2023,
    company: 'Company Name',
    href: '#',
    current: true,
    role: 'Senior Product Designer',
    description:
      'One or two lines about the company and what you did there. Lead with impact: what you shipped and who it reached.',
    logos: ['CN', 'P1'],
    projects: ['lending-onboarding'],
  },
  {
    code: 'SG',
    year: 2020,
    company: 'Company Name',
    href: '#',
    current: false,
    role: 'Product Designer',
    description: 'What the company does, and the part you played in it.',
    logos: ['CN'],
    projects: ['design-system'],
  },
  {
    code: 'JKT',
    year: 2018,
    company: 'Independent',
    href: '#',
    current: false,
    role: 'UI/UX Designer',
    description: 'Where you learned the ropes. Freelance, studio, or side projects all count.',
    logos: ['IN'],
    projects: ['budgeting-app'],
  },
];

const closing = {
  title: 'Thanks for stopping by.',
  body: 'A few snapshots from outside the screen.',
};

const memories = [
  { src: memory1, alt: 'Caption one' },
  { src: memory2, alt: 'Caption two' },
  { src: memory3, alt: 'Caption three' },
  { src: memory4, alt: 'Caption four' },
  { src: memory5, alt: 'Caption five' },
];

// ——— End of editable block ———

const projectsById = new Map(
  (await getCollection('projects', ({ data }) => !data.draft)).map((p) => [p.id, p]),
);
---

<CvLayout title="About" description={`About ${site.name}, ${site.role}.`}>
  <header class="hero">
    <div class="portrait">
      <Image src={portrait} alt={`Portrait of ${site.name}`} width={240} loading="eager" />
    </div>
    <h1>{headline}</h1>
    <p>{intro}</p>
  </header>

  <ol class="timeline" aria-label="Career timeline">
    {
      timeline.map((entry) => (
        <li class="entry">
          <span class="when" aria-hidden="true">
            <span class="code">{entry.code}</span>
            <span class="year">{entry.year}</span>
          </span>
          <div class="logos" aria-hidden="true">
            {entry.logos.map((l) => (
              <span class="logo">{l}</span>
            ))}
          </div>
          <h2>
            <a href={entry.href}>{entry.company}</a>
            {entry.current && <span class="badge">Current</span>}
            <span class="visually-hidden">, {entry.year}</span>
          </h2>
          <p class="role">{entry.role}</p>
          <p class="desc">{entry.description}</p>

          {entry.projects.length > 0 && (
            <ul class="projects">
              {entry.projects.map((pid) => {
                const p = projectsById.get(pid);
                if (!p) return null;
                return (
                  <li>
                    <a href={`/work/${p.id}`} class="project">
                      <span class="stack" aria-hidden="true">
                        <span class="card back" />
                        <span class="card mid" />
                        <Image class="card front" src={p.data.cover} alt="" width={96} />
                      </span>
                      <span class="project-text">
                        <span class="project-title">{p.data.title}</span>
                        <span class="project-summary">{p.data.summary}</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </li>
      ))
    }
    <li class="entry end">
      <div class="closing">
        <div>
          <p class="closing-title">{closing.title}</p>
          <p class="closing-body">{closing.body}</p>
        </div>
        <ul class="memories">
          {
            memories.map((m) => (
              <li>
                <Image src={m.src} alt={m.alt} width={120} title={m.alt} />
              </li>
            ))
          }
        </ul>
      </div>
    </li>
  </ol>
</CvLayout>

<style>
  /* ——— Hero ——— */
  .hero {
    max-width: 460px;
    margin: 0 auto;
    padding-top: 40px;
    text-align: center;
  }
  @media (min-width: 900px) {
    .hero {
      padding-top: 96px;
    }
  }
  .portrait {
    width: 180px;
    aspect-ratio: 180 / 234;
    margin: 0 auto 40px;
    padding: 10px;
    border-radius: 90px;
    background: linear-gradient(160deg, #f3efec, #ddd6d2);
    box-shadow:
      0 18px 40px -18px rgb(0 0 0 / 0.35),
      inset 0 1px 0 rgb(255 255 255 / 0.8);
  }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 80px;
    box-shadow: inset 0 4px 12px rgb(0 0 0 / 0.2);
  }
  .hero p {
    color: var(--a-muted);
  }

  /* ——— Timeline ——— */
  .timeline {
    /* The timeline sits this far left of the content column. */
    --rail: 22px;
    position: relative;
    max-width: 560px;
    margin: 56px auto 0;
    padding: 0 0 0 calc(var(--rail) + 8px);
    list-style: none;
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 12px;
    left: 0;
    border-left: 1px dashed var(--a-faint);
  }
  @media (min-width: 900px) {
    .timeline {
      padding-left: 0;
    }
    .timeline::before {
      left: calc(-1 * var(--rail));
    }
  }

  .entry {
    position: relative;
    padding-bottom: 56px;
  }

  .when {
    position: absolute;
    top: 46px;
    left: calc(-1 * var(--rail) - 8px);
    transform: translateX(-50%);
  }
  .when::after {
    content: '';
    position: absolute;
    top: 8px;
    left: 50%;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    border-radius: 50%;
    border: 1px solid var(--a-faint);
    background: radial-gradient(var(--a-faint) 35%, var(--a-bg) 40%);
  }
  .code,
  .year {
    display: none;
  }
  @media (min-width: 900px) {
    .when {
      left: calc(-1 * var(--rail));
    }
    .when::after {
      left: 0;
    }
    .code,
    .year {
      display: block;
      position: absolute;
      right: 16px;
      font-family: var(--a-mono);
      font-weight: 500;
      text-align: right;
      white-space: nowrap;
    }
    .code {
      top: -2px;
      font-size: 7px;
      letter-spacing: 0.15em;
      color: var(--a-faint);
    }
    .year {
      top: 4px;
      font-size: 12px;
      letter-spacing: 0.09em;
      color: var(--a-muted);
    }
  }

  .logos {
    display: flex;
    margin-bottom: 4px;
  }
  .logo {
    display: grid;
    place-items: center;
    width: 29px;
    height: 29px;
    margin-right: -7px;
    border-radius: 50%;
    border: 2px solid var(--a-bg);
    background: var(--a-ink);
    color: var(--a-bg);
    font-family: var(--a-mono);
    font-size: 9px;
    font-weight: 500;
  }
  .logo:nth-child(2) {
    background: var(--a-accent);
  }

  .entry h2 {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .entry h2 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--a-faint);
  }
  .badge {
    font-family: var(--a-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--a-accent);
  }
  .role {
    font-weight: 500;
  }

  /* Project rows */
  .projects {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
  }
  .projects li {
    position: relative;
  }
  .projects li::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(-1 * var(--rail) - 8px - 2px);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--a-faint);
  }
  @media (min-width: 900px) {
    .projects li::before {
      left: calc(-1 * var(--rail) - 2px);
    }
  }
  .project {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 12px 10px 20px;
    margin-left: -12px;
    border-radius: 12px;
    transition: background-color 0.2s;
  }
  .project:hover {
    background: color-mix(in srgb, var(--a-ink) 4%, transparent);
  }
  .stack {
    position: relative;
    flex: none;
    width: 56px;
    height: 46px;
  }
  .card {
    position: absolute;
    top: 4px;
    left: 14px;
    width: 30px;
    height: 38px;
    border-radius: 4px;
    background: var(--a-card);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.15);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .back {
    transform: translateX(-10px) rotate(-8deg);
    background: color-mix(in srgb, var(--a-card) 80%, var(--a-faint));
  }
  .mid {
    transform: translateX(10px) rotate(8deg);
    background: color-mix(in srgb, var(--a-card) 90%, var(--a-faint));
  }
  .front {
    top: 0;
    left: 12px;
    width: 34px;
    height: 44px;
    object-fit: cover;
    border: 2px solid var(--a-card);
  }
  .project:hover .back {
    transform: translateX(-16px) rotate(-14deg);
  }
  .project:hover .mid {
    transform: translateX(16px) rotate(14deg);
  }
  .project:hover .front {
    transform: translateY(-2px) scale(1.06);
  }
  .project-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .project-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--a-ink);
  }
  .project-summary {
    font-size: 13px;
    font-weight: 500;
    color: var(--a-muted);
  }

  /* ——— Closing ——— */
  .end {
    padding-bottom: 0;
  }
  .end::before {
    content: '';
    position: absolute;
    top: 10px;
    left: calc(-1 * var(--rail) - 8px - 4px);
    width: 7px;
    height: 7px;
    border-right: 1px solid var(--a-accent);
    border-bottom: 1px solid var(--a-accent);
    transform: rotate(45deg);
    background: var(--a-bg);
  }
  @media (min-width: 900px) {
    .end::before {
      left: calc(-1 * var(--rail) - 4px);
    }
  }
  .closing {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .closing-title {
    font-weight: 500;
    color: var(--a-ink);
  }
  .closing-body {
    font-size: 14px;
  }
  .memories {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0 0 0 10px;
  }
  .memories li {
    margin-left: -12px;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .memories li:nth-child(odd) {
    transform: rotate(-6deg);
  }
  .memories li:nth-child(even) {
    transform: rotate(5deg);
  }
  .memories li:hover {
    transform: translateY(-8px) rotate(0) scale(1.15);
    z-index: 1;
  }
  .memories :global(img) {
    width: 44px;
    height: 57px;
    object-fit: cover;
    border-radius: 4px;
    border: 2px solid var(--a-card);
    box-shadow: 0 4px 10px rgb(0 0 0 / 0.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .memories li,
    .project {
      transition: none;
    }
  }
</style>
