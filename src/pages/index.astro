---
import { getCollection } from 'astro:content';
import CvLayout from '../layouts/CvLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<CvLayout>
  <header class="hero">
    <h1>{site.role}</h1>
    <p>{site.intro}</p>
  </header>

  <section class="work" id="work" aria-labelledby="work-heading">
    <div class="work-head">
      <span class="label" id="work-heading">Selected work</span>
      <span class="label">{String(projects.length).padStart(2, '0')}</span>
    </div>
    <div class="list">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>

  <aside class="closing">
    <p class="closing-title">Want the longer story?</p>
    <a href="/about">Read about me and where I've worked →</a>
  </aside>
</CvLayout>

<style>
  .hero {
    max-width: 460px;
    margin: 0 auto;
    padding-top: 48px;
    text-align: center;
  }
  @media (min-width: 900px) {
    .hero {
      padding-top: 200px;
    }
  }
  .hero p {
    color: var(--a-muted);
  }

  .work {
    max-width: 640px;
    margin: 80px auto 0;
  }
  .work-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-inline: 4px;
  }
  .list {
    display: grid;
    gap: 72px;
  }

  .closing {
    max-width: 640px;
    margin: 96px auto 0;
    padding-inline: 4px;
    text-align: center;
  }
  .closing-title {
    font-weight: 500;
    color: var(--a-ink);
  }
  .closing a {
    font-size: 14px;
    color: var(--a-muted);
    transition: color 0.2s;
  }
  .closing a:hover {
    color: var(--a-ink);
  }
</style>
