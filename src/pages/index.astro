---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base>
  <Hero eyebrow={`${site.role} — ${site.location}`}>{site.intro}</Hero>

  <section class="container" id="work" aria-labelledby="work-heading">
    <SectionHead id="work-heading" title="Selected work" meta={`${projects.length} projects`} />
    <div class="grid">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(3rem, 6vw, 5rem) var(--gutter);
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    /* Offset the right column for an editorial rhythm. */
    .grid > :global(:nth-child(even)) {
      margin-top: 6rem;
    }
  }
</style>
