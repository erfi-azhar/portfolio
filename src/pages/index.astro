---
import StudioLayout from '../layouts/StudioLayout.astro';
import Sticker from '../components/studio/Sticker.astro';
import { site } from '../site';
import { timeline, yearRange } from '../data/career';

// ——— Edit the intro here ———
// Each paragraph is a list of pieces. Plain text lights up word by word as you
// scroll. The objects add the inline extras:
//   { logos: n }        your n most recent companies, with dates on hover
//   { frame: 'word' }   a word wrapped in a design-tool selection box
//   { gradient: 'word' } a word in colour
//   { click: 'word' }   a word a cursor glides over and clicks once it lights up
//                       (hover it to replay)
//   { wave: true }      a ✌️ to sign off
type Piece =
  | string
  | { logos: number }
  | { frame: string; label?: string }
  | { gradient: string }
  | { click: string }
  | { wave: true };

// The first paragraph is shown as a slightly bolder lead.
const paragraphs: Piece[][] = [
  ['I make complex products feel', { frame: 'clear,', label: 'Frame 1' }, 'intuitive, and', { gradient: 'human.' }],
  [
    "I'm a product designer with over a decade of experience across banks, startups, and design studios.",
    { logos: 3 },
    'I help teams turn business ambition and real human needs into thoughtful products—from everyday',
    { click: 'interactions' },
    'to decisions that carry real weight.',
  ],
  [
    'My work spans fintech, commerce, media, and Web3 across Asia and the US. I bring a global perspective to local problems, connecting product strategy with the details that shape how people understand, trust, and use what we build.',
  ],
  [
    'I care about what a product helps people do, how it feels, and the responsibility that comes with putting it into the world.',
    { wave: true },
  ],
];
// ——— End of editable block ———

const words = (text: string) => text.split(/\s+/).filter(Boolean);
const range = (r: (typeof timeline)[number]) => yearRange(r.start, r.end);
---

<StudioLayout>
  <section class="intro">
    <div class="content">
      <div class="name-wrap" data-sticker-bounds>
        <h1 class="name">{site.name}</h1>
        <div class="sticker-anchor">
          <Sticker text={site.role} />
        </div>
      </div>

      <div class="reveal" data-reveal>
        {
          paragraphs.map((pieces, n) => (
            <p class:list={[{ lead: n === 0 }]}>
              {pieces.map((piece) => {
                if (typeof piece === 'string')
                  return words(piece).map((w) => (
                    <>
                      <span class="w">{w}</span>{' '}
                    </>
                  ));
                if ('logos' in piece)
                  return (
                    <>
                      <span class="pop logos" data-pop>
                        {timeline.slice(0, piece.logos).map((r, i) => (
                          <span class="logo" tabindex="0" style={`--i:${i}`}>
                            <span aria-hidden="true">{r.logos[0]}</span>
                            <span class="tip" role="tooltip">
                              <span class="tip-name">{r.company}</span>
                              <span class="tip-years">{range(r)}</span>
                            </span>
                            <span class="visually-hidden">
                              {r.company}, {range(r)}
                            </span>
                          </span>
                        ))}
                      </span>{' '}
                    </>
                  );
                if ('frame' in piece)
                  return (
                    <>
                      <span class="frame">
                        <span class="frame-ui" aria-hidden="true">
                          <span class="frame-label">{piece.label ?? 'Frame'}</span>
                          <i class="h tl" />
                          <i class="h tr" />
                          <i class="h bl" />
                          <i class="h br" />
                        </span>
                        <span class="w">{piece.frame}</span>
                      </span>{' '}
                    </>
                  );
                if ('gradient' in piece)
                  return (
                    <>
                      <span class="w gradient">{piece.gradient}</span>{' '}
                    </>
                  );
                if ('click' in piece)
                  return (
                    <>
                      <span class="w click" data-click>
                        <span class="click-word">{piece.click}</span>
                        <span class="click-cursor" aria-hidden="true">
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path
                              d="M5.5 3.21V20.8c0 .45.54.67.85.35l4.86-4.86a.5.5 0 0 1 .35-.15h6.87a.5.5 0 0 0 .35-.85L6.35 2.86a.5.5 0 0 0-.85.35Z"
                              fill="#22c55e"
                              stroke="#166534"
                              stroke-width="1.5"
                            />
                          </svg>
                        </span>
                      </span>{' '}
                    </>
                  );
                return (
                  <span class="pop wave" data-pop aria-hidden="true">
                    ✌️
                  </span>
                );
              })}
            </p>
          ))
        }
      </div>
    </div>
  </section>
</StudioLayout>

<script>
  // Scroll-linked effects:
  // 1. The intro lights up word by word. A "front" moves through the text as you
  //    scroll through it; words fade from 15% to full over a six-word edge, and
  //    the inline extras pop in once the front reaches them.
  // 2. When the click word is fully lit, a cursor glides across it and clicks;
  //    hovering replays it, and it fades away if the word dims again.
  const FEATHER = 6;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const root = document.querySelector<HTMLElement>('[data-reveal]');

  type Node = { el: HTMLElement; index: number; lit: number; on?: boolean };
  const words: Node[] = [];
  const pops: Node[] = [];
  const frames: Node[] = [];

  if (root) {
    let count = 0;
    for (const el of root.querySelectorAll<HTMLElement>('.w, [data-pop]')) {
      if (el.matches('.w')) {
        words.push({ el, index: count++, lit: -1 });
        const frame = el.closest<HTMLElement>('.frame');
        if (frame) frames.push({ el: frame, index: count - 1, lit: 0 });
      } else {
        pops.push({ el, index: Math.max(0, count - 1), lit: 0 });
      }
    }
    root.classList.add('live');
  }

  // ——— Click word ———
  // Each step animates the cursor from its current state to new values. x is a
  // CSS length, so '105%' means 105% of the cursor's own width.
  type CursorState = { x: string; y: number; scale: number; opacity: number };
  type Step = { to?: Partial<CursorState>; duration?: number; ease?: string; delay?: number; call?: () => void };
  const EASE = {
    power1InOut: 'cubic-bezier(0.45, 0, 0.55, 1)',
    power2Out: 'cubic-bezier(0.33, 1, 0.68, 1)',
    power2In: 'cubic-bezier(0.32, 0, 0.67, 0)',
    power2InOut: 'cubic-bezier(0.65, 0, 0.35, 1)',
    backOut: 'cubic-bezier(0.34, 1.5, 0.64, 1)',
  };

  class ClickWord {
    word: HTMLElement;
    cursor: HTMLElement;
    state: CursorState = { x: '-24px', y: 0, scale: 0.5, opacity: 0 };
    revealed = false;
    running = false;
    run = 0;

    constructor(word: HTMLElement) {
      this.word = word;
      this.cursor = word.querySelector<HTMLElement>('.click-cursor')!;
      this.apply(this.state);
      word.addEventListener('mouseenter', () => {
        if (this.revealed && !this.running) this.play(false);
      });
    }

    css(s: CursorState) {
      return { transform: `translate(${s.x}, ${s.y}px) scale(${s.scale})`, opacity: String(s.opacity) };
    }
    apply(s: CursorState) {
      Object.assign(this.cursor.style, this.css(s));
    }
    async sequence(steps: Step[], id: number) {
      for (const step of steps) {
        if (id !== this.run) return;
        if (step.delay) await new Promise((r) => setTimeout(r, step.delay! * 1000));
        if (id !== this.run) return;
        step.call?.();
        if (!step.to) continue;
        const from = this.state;
        const to = { ...from, ...step.to };
        const anim = this.cursor.animate([this.css(from), this.css(to)], {
          duration: (step.duration ?? 0) * 1000,
          easing: step.ease ?? 'linear',
          fill: 'forwards',
        });
        this.state = to;
        await anim.finished.catch(() => {});
        if (id !== this.run) return;
        this.apply(to);
        anim.cancel();
      }
    }
    press(on: boolean) {
      this.word.classList.toggle('pressed', on);
    }
    // Timings follow the reference: glide across, click, glide back.
    play(intro: boolean) {
      if (reduceMotion) return;
      this.running = true;
      const id = ++this.run;
      const steps: Step[] = [
        ...(intro
          ? [
              { to: { x: '-24px', scale: 0.5, opacity: 0, y: 0 } },
              { to: { scale: 1, opacity: 1 }, duration: 0.4, ease: EASE.power2Out },
            ]
          : []),
        { to: { scale: 1.3, x: '0px' }, duration: 0.3, ease: EASE.power2Out },
        { to: { x: '105%' }, duration: 0.7, ease: EASE.power1InOut },
        { to: { x: '95%' }, duration: 0.25, ease: EASE.power2Out },
        { to: { scale: 1.1, y: 6 }, duration: 0.1, ease: EASE.power2In },
        { call: () => this.press(true) },
        { to: { scale: 1.3, y: 0 }, duration: 0.2, ease: EASE.backOut, delay: 0.02 },
        { call: () => this.press(false), delay: 0.03 },
        { to: { x: '-24px' }, duration: 0.5, ease: EASE.power2InOut, delay: 0.15 },
        { to: { scale: 1 }, duration: 0.2, ease: EASE.power2Out },
      ];
      this.sequence(steps, id).finally(() => {
        if (id === this.run) this.running = false;
      });
    }
    hide() {
      const id = ++this.run;
      this.running = false;
      this.press(false);
      if (reduceMotion) {
        this.state = { ...this.state, opacity: 0 };
        this.apply(this.state);
        return;
      }
      this.sequence([{ to: { scale: 0.5, opacity: 0 }, duration: 0.3, ease: EASE.power2In }], id);
    }
    update(lit: number) {
      if (!this.revealed && lit >= 0.999) {
        this.revealed = true;
        if (reduceMotion) {
          this.state = { x: '-24px', y: 0, scale: 1, opacity: 1 };
          this.apply(this.state);
        } else this.play(true);
      } else if (this.revealed && lit < 0.5) {
        this.revealed = false;
        this.hide();
      }
    }
  }

  const clickWords = new Map<HTMLElement, ClickWord>();
  for (const el of root?.querySelectorAll<HTMLElement>('[data-click]') ?? []) clickWords.set(el, new ClickWord(el));

  let current = 0;
  let target = 0;
  let frame = 0;

  const measure = () => {
    if (!root) return 0;
    const r = root.getBoundingClientRect();
    const progress = (window.innerHeight * 0.6 - r.top) / r.height;
    return Math.min(1, Math.max(0, progress)) * (words.length + FEATHER);
  };

  const paint = () => {
    frame = 0;

    const gap = target - current;
    current = reduceMotion || Math.abs(gap) < 0.01 ? target : current + gap * 0.18;

    for (const w of words) {
      const lit = Math.min(1, Math.max(0, (current - w.index) / FEATHER));
      if (Math.abs(lit - w.lit) > 0.005 || (lit === 1 && w.lit !== 1)) {
        w.lit = lit;
        w.el.style.setProperty('--lit', lit.toFixed(3));
        clickWords.get(w.el)?.update(lit);
      }
    }
    for (const n of [...pops, ...frames]) {
      const on = current - n.index >= FEATHER * 0.9;
      if (on !== n.on) {
        n.on = on;
        n.el.classList.toggle('on', on);
      }
    }

    if (current !== target) frame = requestAnimationFrame(paint);
  };

  const update = () => {
    target = measure();
    if (!frame) frame = requestAnimationFrame(paint);
  };

  current = measure();
  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
</script>

<style>
  /* ——— Name ——— */
  .intro {
    position: relative;
    z-index: 2;
    padding-block: clamp(140px, 16vw, 240px) clamp(96px, 12vw, 160px);
  }
  .name-wrap {
    position: relative;
    width: fit-content;
    max-width: 100%;
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .name {
    font-size: clamp(44px, 10.8vw, 155px);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: var(--fg);
    text-wrap: balance;
  }
  /* Where the sticker sits before anyone drags it: on the name's top edge. */
  .sticker-anchor {
    position: absolute;
    top: 0;
    right: -0.15em;
    transform: translateY(-70%);
  }
  @media (max-width: 640px) {
    .sticker-anchor {
      transform: translateY(-120%);
    }
  }

  /* ——— Reveal text ——— */
  .reveal {
    display: grid;
    gap: clamp(24px, 3vw, 40px);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.9;
    color: var(--fg);
  }
  @media (min-width: 768px) {
    .reveal {
      font-size: 36px;
      line-height: 2.1;
    }
  }
  @media (min-width: 1024px) {
    .reveal {
      font-size: 48px;
      line-height: 2;
    }
  }
  @media (max-width: 480px) {
    .reveal {
      font-size: 1.6rem;
    }
  }
  .lead {
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .w {
    --lit: 1;
    color: color-mix(in oklch, var(--fg) calc(var(--lit) * 100%), var(--dim-word));
  }
  .w.gradient {
    color: transparent;
    background: linear-gradient(90deg, #f472b6, #a78bfa, #60a5fa, #facc15);
    -webkit-background-clip: text;
    background-clip: text;
    opacity: calc(0.15 + 0.85 * var(--lit));
  }

  /* Inline extras: shown by default; once the script is running they wait for
     the reading front to reach them, then pop in. */
  .pop {
    display: inline-flex;
    vertical-align: middle;
    transition:
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.25s,
      max-width 0.45s var(--ease-out),
      margin 0.45s var(--ease-out);
    max-width: 8em;
  }
  .live .pop:not(:global(.on)) {
    max-width: 0;
    opacity: 0;
    transform: scale(0);
    margin: 0 !important;
  }

  .logos {
    margin-inline: 0.1em 0.2em;
  }
  .logo {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.15em;
    height: 1.15em;
    margin-left: calc(var(--i) * -0.3em);
    border: 3px solid var(--bg);
    border-radius: 0.32em;
    background: var(--surface-raised);
    color: var(--fg);
    font-family: var(--mono);
    font-size: 0.85em;
    font-weight: 500;
    line-height: 1;
    transform: rotate(calc(var(--i) * 6deg - 6deg));
    transition: transform 0.3s var(--ease-out);
    cursor: default;
  }
  .logo > span[aria-hidden] {
    font-size: 0.42em;
  }
  .logo:nth-child(1) {
    background: #f4f4f5;
    color: #111;
  }
  .logo:nth-child(2) {
    background: var(--accent);
    color: #0b0b12;
  }
  .logo:hover,
  .logo:focus-visible {
    z-index: 2;
    transform: translateY(-0.12em) rotate(0) scale(1.08);
  }
  .tip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    display: grid;
    padding: 8px 14px;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 12px 30px -10px rgb(0 0 0 / 0.7);
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.35;
    text-align: center;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 6px);
    transition:
      opacity 0.2s,
      transform 0.2s var(--ease-out);
    pointer-events: none;
  }
  .tip-years {
    font-size: 12px;
    color: var(--muted);
  }
  .logo:hover .tip,
  .logo:focus-visible .tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* A word wrapped in a design-tool selection box. */
  .frame {
    position: relative;
    display: inline-block;
    padding-inline: 0.12em;
  }
  .frame-ui {
    position: absolute;
    inset: 0.32em 0 0.32em;
    border: 1.5px dashed #0d99ff;
    transition: opacity 0.3s;
  }
  .live .frame:not(:global(.on)) .frame-ui {
    opacity: 0;
  }
  .frame-label {
    position: absolute;
    bottom: 100%;
    left: -1px;
    margin-bottom: 2px;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.2;
    color: #0d99ff;
    white-space: nowrap;
  }
  .h {
    position: absolute;
    width: 7px;
    height: 7px;
    border: 1.5px solid #0d99ff;
    background: #fff;
  }
  .tl {
    top: -4px;
    left: -4px;
  }
  .tr {
    top: -4px;
    right: -4px;
  }
  .bl {
    bottom: -4px;
    left: -4px;
  }
  .br {
    bottom: -4px;
    right: -4px;
  }

  /* A word a cursor glides over and clicks. */
  .click {
    position: relative;
    display: inline-block;
    cursor: pointer;
  }
  .click-word {
    position: relative;
    display: inline-block;
    transition: transform 0.1s ease-out;
  }
  .click:global(.pressed) .click-word {
    transform: scale(0.97);
  }
  .click-cursor {
    position: absolute;
    top: 0.5em;
    left: 0;
    line-height: 0;
    pointer-events: none;
    opacity: 0;
  }
  .wave {
    margin-left: 0.1em;
    font-size: 0.8em;
  }

  @media (prefers-reduced-motion: reduce) {
    .pop,
    .frame-ui {
      transition: none;
    }
  }
</style>
