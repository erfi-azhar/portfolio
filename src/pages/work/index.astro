---
import { getCollection } from 'astro:content';
import StudioLayout from '../../layouts/StudioLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { site } from '../../site';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<StudioLayout title="Work" description={`Selected work by ${site.name}.`}>
  <section class="content work">
    <header class="head">
      <h1>Work</h1>
      <p>Selected projects, newest first.</p>
    </header>
    <div class="list">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>
</StudioLayout>

<style>
  .work {
    padding-block: clamp(120px, 14vw, 200px) clamp(96px, 10vw, 160px);
  }
  .head {
    margin-bottom: clamp(48px, 6vw, 80px);
  }
  h1 {
    font-size: clamp(44px, 8vw, 112px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .head p {
    margin-top: 16px;
    font-size: 18px;
    color: var(--muted);
  }
  .list {
    display: grid;
    gap: 72px;
  }
  @media (min-width: 900px) {
    .list {
      grid-template-columns: 1fr 1fr;
      gap: 80px var(--gutter);
    }
  }
</style>
